Python program to calculate Good-Turing frequency
from collections import defaultdict

def build_bigram_model(tokens):
    model = defaultdict(lambda: defaultdict(int))

    for i in range(len(tokens) - 1):
        model[tokens[i]][tokens[i + 1]] += 1

    return model


def good_turing(model):
    freq = defaultdict(int)
    total = 0

    # Count frequencies of frequencies
    for context in model:
        for count in model[context].values():
            freq[count] += 1
            total += count

    probs = defaultdict(dict)

    # Apply Good-Turing formula
    for context in model:
        for word, count in model[context].items():
            nc = freq[count]
            nc1 = freq.get(count + 1, 0)

            if nc1 == 0 or nc == 0:
                new_count = count
            else:
                new_count = (count + 1) * nc1 / nc

            probs[context][word] = new_count / total if total else 0

    unseen = freq[1] / total if total else 0
    return probs, unseen


if __name__ == "__main__":
    text = "I love natural language processing and I love artificial intelligence"
    tokens = text.split()

    model = build_bigram_model(tokens)
    probs, unseen = good_turing(model)

    print("Smoothed Bigram Probabilities:\n")

    for context in probs:
        for word, prob in probs[context].items():
            print("P({} | {}) = {:.6f}".format(
                word, context, prob
            ))

    print("\nProbability for unseen bigrams: {:.6f}".format(unseen))

    test = "I love machine learning"
    words = test.split()

    print("\nTest Bigram Probabilities:\n")

    for i in range(len(words) - 1):
        context = words[i]
        word = words[i + 1]

        prob = probs[context].get(word, unseen)
        print("P({} | {}) = {:.6f}".format(
            word, context, prob
        ))
