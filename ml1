Python program to implement a Bigram Model and calculate the probability of a test sentence
from collections import defaultdict

# Training corpus
corpus = [
    "i love natural language processing",
    "i love machine learning",
    "i enjoy natural language processing"
]

# Build bigram model
unigrams = defaultdict(int)
bigrams = defaultdict(int)

for sentence in corpus:
    words = sentence.split()

    for i in range(len(words)):
        unigrams[words[i]] += 1

        if i > 0:
            bigrams[(words[i-1], words[i])] += 1

# Calculate bigram probability
def bigram_probability(w1, w2):
    return bigrams[(w1, w2)] / unigrams[w1]

# Test sentence
test = "i love natural language processing"
words = test.split()

probability = 1.0

for i in range(1, len(words)):
    p = bigram_probability(words[i-1], words[i])
    probability *= p
    print("P({} | {}) = {:.3f}".format(
        words[i], words[i-1], p
    ))

print("\nProbability of test sentence =", round(probability, 6))

